# Copy this file outside the repository for production use, for example:
#   ~/.config/codexui/.env
# Keep the containing directory mode 700 and this file mode 600.

# Optional path overrides
CODEX_HOME=
CODEXUI_CODEX_COMMAND=

# Optional Claude Code chats. When CodexUI runs as a macOS LaunchDaemon, run the
# claude-host LaunchAgent (deployment/macos) and set its socket here so Claude
# Code starts in the login session, where its keychain sign-in is available.
CODEXUI_CLAUDE_HOST_SOCKET=
# Optional Claude CLI to use instead of the one bundled with the Agent SDK.
CODEXUI_CLAUDE_PATH=
# Optional native Mac control through Codex's installed Computer Use plugin.
# Use "auto" to load the newest installed bundled plugin configuration.
CODEXUI_CLAUDE_COMPUTER_USE_MCP_FILE=
# Set to "never" to let Claude chats control this Mac without an approval card.
# Leave empty to ask before each action, with an "Allow for this chat" choice.
CODEXUI_CLAUDE_COMPUTER_USE_APPROVAL=
# Optional claude-swap executable; otherwise ~/.local/bin/cswap or PATH is used.
CODEXUI_CSWAP_PATH=

# Optional default thinking effort for new threads.
# Supported: none, minimal, low, medium, high, xhigh, max, ultra
CODEXUI_DEFAULT_REASONING_EFFORT=

# Model for new chats, for example `claude-default` or a Codex model id such as `gpt-5.5`.
# Leave empty to use the Codex default. Existing chats keep their own model, and Codex chats
# never receive a Claude model.
CODEXUI_DEFAULT_MODEL=

# Optional app password. Leave empty to generate a password on startup.
CODEXUI_PASSWORD=

# Optional public URL used in notification links.
CODEXUI_PUBLIC_BASE_URL=

# Optional Telegram turn notifications.
CODEXUI_TELEGRAM_NOTIFICATIONS=false
CODEXUI_TELEGRAM_BOT_TOKEN=
CODEXUI_TELEGRAM_CHAT_ID=

# Optional web-push notifications.
CODEXUI_WEB_PUSH_STATE_FILE=
CODEXUI_WEB_PUSH_PUBLIC_KEY=
CODEXUI_WEB_PUSH_PRIVATE_KEY=
CODEXUI_WEB_PUSH_SUBJECT=

# Optional voice commands (an iPhone Shortcut posts audio or text). Agents never see these.
# The Shortcut routes (/codex-api/voice/shortcut/*) stay disabled until the token is set
# (24+ random characters). Put them behind an authenticated gateway as well.
CODEXUI_VOICE_SHORTCUT_TOKEN=
# Jev (TypeSafe) routes each command. Without it every command is "didn't catch that".
CODEXUI_VOICE_TYPESAFE_API_KEY=
# Cuts out the message when no rule fits: Claude Haiku first, then DeepSeek, then Kimi.
CODEXUI_VOICE_ANTHROPIC_API_KEY=
CODEXUI_VOICE_ANTHROPIC_WORKSPACE_ID=
CODEXUI_VOICE_DEEPSEEK_API_KEY=
CODEXUI_VOICE_KIMI_API_KEY=

# Optional Apple Watch app API (/codex-api/voice/shortcut/watch/*). Agents never see it.
# Stays disabled (404) until set (24+ random characters); every request, local ones too, must send
# "Authorization: Bearer <token>". Separate from the Shortcut token so either can be revoked alone.
CODEXUI_WATCH_TOKEN=

# Optional credential used by a separately configured Jina MCP server.
JINA_API_KEY=
