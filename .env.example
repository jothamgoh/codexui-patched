# Copy this file outside the repository for production use, for example:
#   ~/.config/codexui/.env
# Keep the containing directory mode 700 and this file mode 600.

# Optional path overrides
CODEX_HOME=
CODEXUI_CODEX_COMMAND=

# Optional default thinking effort for new threads.
# Supported: none, minimal, low, medium, high, xhigh, max, ultra
CODEXUI_DEFAULT_REASONING_EFFORT=

# Optional app password. Leave empty to generate a password on startup.
CODEXUI_PASSWORD=

# Optional public URL used in notification links.
CODEXUI_PUBLIC_BASE_URL=

# Optional Telegram turn notifications.
CODEXUI_TELEGRAM_NOTIFICATIONS=false
CODEXUI_TELEGRAM_BOT_TOKEN=
CODEXUI_TELEGRAM_CHAT_ID=

# Optional web-push notifications.
CODEXUI_WEB_PUSH_STATE_FILE=
CODEXUI_WEB_PUSH_PUBLIC_KEY=
CODEXUI_WEB_PUSH_PRIVATE_KEY=
CODEXUI_WEB_PUSH_SUBJECT=

# Optional credential used by a separately configured Jina MCP server.
JINA_API_KEY=
