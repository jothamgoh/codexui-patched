#!/bin/zsh
# One-shot CodexUI restart that a Claude chat inside CodexUI may start itself.
# Claude chats run under the Claude host LaunchAgent, not the CodexUI daemon, so the
# detached copy of this script survives the restart it triggers.
#
# 1. Waits until the calling Claude chat's reply has finished (CLAUDE_CODE_SESSION_ID),
#    or a fixed delay outside a Claude chat (first argument, default 20 s).
# 2. Runs exactly one kickstart and one health check. No retries.
# Other chats still mid-reply are recorded at shutdown and continued by CodexUI after it starts.
set -u

# Copy this file outside the repository, then replace the service label placeholder.

label="com.codexui.USER"
base="http://127.0.0.1:5999"
log="$HOME/Library/Logs/codexui-restart.log"
stamp="$HOME/.config/codexui/.last-restart"

if [[ "${1:-}" == "--run" ]]; then
  thread="${2:-}"
  delay="${3:-20}"
  caller_busy() {
    /usr/bin/curl --silent --max-time 5 -X POST -H 'content-type: application/json' \
      -d "{\"method\":\"thread/read\",\"params\":{\"threadId\":\"$thread\",\"includeTurns\":false}}" \
      "$base/codex-api/rpc" | /usr/bin/grep -q '"status":{"type":"active"}'
  }
  if [[ -n "$thread" ]]; then
    waited=0
    while caller_busy; do
      if (( waited >= 900 )); then echo "$(/bin/date) calling chat still busy after 15 min; restart cancelled"; exit 1; fi
      /bin/sleep 1; (( waited += 1 ))
    done
    /bin/sleep 2
  else
    /bin/sleep "$delay"
  fi
  if [[ -n "$thread" ]]; then
    # Continue the calling chat after the restart too, not only chats still mid-reply.
    /usr/bin/curl --silent --max-time 5 -X POST -H 'content-type: application/json' \
      -d "{\"threadId\":\"$thread\"}" "$base/codex-api/restart/continue-after" >/dev/null || true
  fi
  echo "$(/bin/date) restarting $label"
  /usr/bin/sudo -n /bin/launchctl kickstart -k "system/$label"
  # One check, late enough for a busy Mac to finish starting the service.
  /bin/sleep 20
  if /usr/bin/curl --fail --silent --output /dev/null "$base/codex-api/meta/methods"; then
    echo "$(/bin/date) CodexUI is back"
  else
    echo "$(/bin/date) health check FAILED"
  fi
  exit 0
fi

if [[ "$label" == *USER* ]]; then
  echo "Replace the label placeholder before running this script."
  exit 64
fi

now=$(/bin/date +%s)
last=$(/bin/cat "$stamp" 2>/dev/null || echo 0)
if (( now - last < 180 )); then
  echo "Refused: a restart was already requested $(( now - last ))s ago."
  exit 75
fi
echo "$now" > "$stamp"

thread="${CLAUDE_CODE_SESSION_ID:+claude-$CLAUDE_CODE_SESSION_ID}"
# Fork, then start a new session: no terminal is needed (nohup fails without one).
/usr/bin/perl -MPOSIX -e '$SIG{HUP} = "IGNORE"; exit 0 if fork; POSIX::setsid() or die "setsid: $!"; exec @ARGV' \
  /bin/zsh "${0:A}" --run "$thread" "${1:-20}" >>"$log" 2>&1 </dev/null &!

if [[ -n "$thread" ]]; then
  echo "CodexUI restarts as soon as this reply finishes. Log: $log"
else
  echo "CodexUI restarts in ${1:-20}s. Log: $log"
fi
