{
  "name": "codexui-patched",
  "version": "1.0.0",
  "private": true,
  "description": "A lightweight web interface for Codex that runs on top of the Codex app-server, allowing remote access from any browser",
  "type": "module",
  "license": "MIT",
  "author": "Jotham Goh",
  "contributors": [
    "Pavel Voronin",
    "Igor Levochkin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jothamgoh/codexui-patched.git"
  },
  "homepage": "https://github.com/jothamgoh/codexui-patched#readme",
  "bugs": {
    "url": "https://github.com/jothamgoh/codexui-patched/issues"
  },
  "keywords": [
    "codex",
    "openai",
    "web-ui",
    "remote",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "@internationalized/date": "3.10.0",
    "tsup": {
      "esbuild": "0.28.1"
    }
  },
  "bin": {
    "codexapp": "dist-cli/index.js",
    "codexui": "dist-cli/index.js"
  },
  "files": [
    "dist/",
    "dist-cli/"
  ],
  "scripts": {
    "dev": "vite",
    "build:frontend": "vue-tsc --noEmit && vite build",
    "build:cli": "tsup",
    "build": "npm run build:frontend && npm run build:cli",
    "test": "npm run test:env && npm run test:runtime-config && npm run test:automations && npm run test:pinned-threads && npm run test:thread-pagination && npm run test:thread-scroll && npm run test:web-push && npm run test:skill-uninstall",
    "test:env": "node --test tests/envFile.test.mjs",
    "test:runtime-config": "node --test tests/runtimeConfig.test.mjs",
    "test:automations": "node --test tests/automationStore.test.mjs",
    "test:pinned-threads": "node --test tests/pinnedThreads.test.mjs tests/pinnedThreadsStore.test.mjs tests/threadMetadataStore.test.mjs",
    "test:thread-pagination": "node --test tests/threadPagination.test.mjs",
    "test:thread-scroll": "node --test tests/threadScroll.test.mjs",
    "test:web-push": "node --test tests/webPushDelivery.test.mjs",
    "test:skill-uninstall": "node --test tests/skillUninstall.test.mjs",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@lucide/vue": "^1.25.0",
    "@tailwindcss/typography": "^0.5.19",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^13.1.0",
    "express": "^5.1.0",
    "markdown-it": "^14.1.1",
    "qrcode-terminal": "^0.12.0",
    "reka-ui": "^2.10.1",
    "rrule": "^2.8.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/express": "^5.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/web-bluetooth": "^0.0.21",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.1.18",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vue": "^3.5.13",
    "vue-component-type-helpers": "^3.3.8",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.0"
  }
}
